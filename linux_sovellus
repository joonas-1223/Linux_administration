
from flask import Flask
import sqlite3
from pathlib import Path

app = Flask(__name__)

# Tietokanta sijaitsee samassa kansiossa kuin sovellus
DB_PATH = Path(__file__).resolve().parent / "laskuri.db"


def luo_tietokanta():
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS laskuri (
                id INTEGER PRIMARY KEY,
                kaynnit INTEGER NOT NULL
            )
        """)
        conn.execute(
            "INSERT OR IGNORE INTO laskuri (id, kaynnit) VALUES (1, 0)"
        )


def lisaa_kaynti():
    with sqlite3.connect(DB_PATH, timeout=10) as conn:
        conn.execute(
            "UPDATE laskuri SET kaynnit = kaynnit + 1 WHERE id = 1"
        )
        maara = conn.execute(
            "SELECT kaynnit FROM laskuri WHERE id = 1"
        ).fetchone()[0]
        return maara


@app.route("/")
def etusivu():
    kaynnit = lisaa_kaynti()

    return f"""
