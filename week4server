# MariaDB-yhteys Server B:n paikalliseen tietokantaan
def hae_kaynnit():
    conn = pymysql.connect(
        host="localhost",
        user="visitor_read",
        password=os.environ["VISITOR_READ_PASSWORD"],
        database="visitor_counter"
    )

    try:
        with conn.cursor() as cursor:
            cursor.execute(
                "SELECT visits FROM counter WHERE id = 1"
            )
            return cursor.fetchone()[0]
    finally:
        conn.close()


